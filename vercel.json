{
  "buildCommand": "prisma generate && next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "framework": "nextjs",

  "functions": {
    "api/python/**/*.py": {
      "maxDuration": 60
    }
  },

  "regions": ["iad1"],

  "crons": [
    { "path": "/api/cron/nightly-maintenance", "schedule": "0 8 * * *" },
    { "path": "/api/cron/scrape-subnet",       "schedule": "0 10 * * *" }
  ]
}
